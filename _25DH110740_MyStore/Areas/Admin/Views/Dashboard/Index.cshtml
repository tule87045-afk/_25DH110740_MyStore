@model _25DH110740_MyStore.Models.ViewModel.DashboardVM
@{ ViewBag.Title = "Thống kê"; var maxRev = Model.RevenueByMonth.Any() ? Model.RevenueByMonth.Max(x => x.Value) : 1; var maxOrd = Math.Max(1, Model.OrdersByStatus.Max(x => x.Value)); }
<h2>Thống kê tổng quan</h2>
<div class="row">
    <div class="col-sm-3"><div class="card stat"><div class="num">@Model.ProductCount</div><div class="lbl">Sản phẩm</div></div></div>
    <div class="col-sm-3"><div class="card stat"><div class="num">@Model.CustomerCount</div><div class="lbl">Khách hàng</div></div></div>
    <div class="col-sm-3"><div class="card stat"><div class="num">@Model.OrderCount</div><div class="lbl">Đơn hàng</div></div></div>
    <div class="col-sm-3"><div class="card stat"><div class="num">@Format.Money(Model.Revenue)</div><div class="lbl">Doanh thu (không tính đơn hủy)</div></div></div>
</div>
<div class="row">
    <div class="col-md-6"><div class="card"><h4>Đơn hàng theo trạng thái</h4>
        <table class="table table-condensed">
        @foreach (var s in Model.OrdersByStatus)
        {
            <tr><td style="width:150px">@s.Key</td><td><div class="bar" style="width:@(s.Value * 100 / maxOrd)%"></div></td><td style="width:40px">@s.Value</td></tr>
        }
        </table></div></div>
    <div class="col-md-6"><div class="card"><h4>Doanh thu theo tháng</h4>
        @if (!Model.RevenueByMonth.Any()) { <p class="text-muted">Chưa có dữ liệu.</p> }
        <table class="table table-condensed">
        @foreach (var s in Model.RevenueByMonth)
        {
            <tr><td style="width:90px">@s.Key</td><td><div class="bar" style="width:@((int)(s.Value * 100 / maxRev))%"></div></td><td style="width:130px" class="text-right">@Format.Money(s.Value)</td></tr>
        }
        </table></div></div>
</div>
<div class="card"><h4>Top 5 sản phẩm bán chạy</h4>
    <table class="table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Đã bán</th></tr></thead>
    @foreach (var p in Model.TopProducts) { <tr><td>@p.ProductName</td><td>@p.Category.CategoryName</td><td>@p.Sold</td></tr> }
    </table></div>
