<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Shuttle Pro | Cầu lông chính hãng</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/myStyle/Customer.css" rel="stylesheet" />
    @RenderSection("styles", required: false)
</head>
<body>
    <div class="promo-bar">Freeship đơn từ 500k &middot; Bảo hành chính hãng &middot; <b>Đổi trả 7 ngày</b></div>

    <header class="site-header">
        <div class="container">
            <a class="brand" href="@Url.Action("Index", "Home")"><i class="fa fa-trophy"></i> LETUANTU<span>PREMIUM</span></a>
            <form class="header-search" action="@Url.Action("Index", "Home")" method="get">
                <input type="text" name="searchTerm" placeholder="Tìm vợt, cầu, giày..." value="@Request.QueryString["searchTerm"]" />
                <button type="submit"><i class="fa fa-search"></i></button>
            </form>
            @Html.Action("PersonalMenu", "Shared")
        </div>
        @Html.Action("CategoryMenu", "Shared")
    </header>

    <main class="container page-body">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row">
                <div class="col-sm-6">
                    <h4>LETUANTUPREMIUM</h4>
                    <p>&copy; @DateTime.Now.Year - Cửa hàng cầu lông trực tuyến.</p>
                </div>
                <div class="col-sm-3"><h5>Liên hệ</h5><p>Hotline: 0769897807<br />Email: tule87045@gmil.com</p></div>
                
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
