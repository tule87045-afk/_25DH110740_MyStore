@model _25DH110740_MyStore.Models.ViewModel.HomeProductVM
<section class="section">
    <h2 class="section-title">Sản phẩm nổi bật</h2>
    @if (!Model.FeaturedProducts.Any())
    {
        <p class="text-center text-muted">Không tìm thấy sản phẩm phù hợp.</p>
    }
    else
    {
        <div class="slider">
            <div class="slider-track">
                @foreach (var p in Model.FeaturedProducts)
                {
                    <div class="slide">@Html.Partial("_ProductCard", p)</div>
                }
            </div>
        </div>
    }
</section>
